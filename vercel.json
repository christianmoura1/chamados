{
"functions": {
"api/data.js": {
"includeFiles": "data/**"
}
},
"routes": [
{ "src": "/data/chamados-abertos-perda\\.json", "dest": "/api/data?file=perda" },
{ "src": "/data/gestao-total\\.json", "dest": "/api/data?file=gestao" },
{
"src": "/(.*)",
"headers": {
"X-Frame-Options": "DENY",
"X-Content-Type-Options": "nosniff",
"Referrer-Policy": "no-referrer"
},
"continue": true
},
{ "handle": "filesystem" }
]
}